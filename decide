## 💻 3. 决策 Agent 的 Python 代码实现

你可以把这个 Agent 写成一个独立的模块 `phases/sub_agents/decision_agent.py`，供 `dev_manager.py` 在遇到分支选择时随时调用：

```python
import os
import re
import subprocess

class DecisionAgent:
    def __init__(self, decision_dir="docs/05_Decision_Log"):
        self.decision_dir = decision_dir

    def ask_for_decision(self, issue_id, scenario_description, options_list):
        """
        向决策 Agent 寻求指导。
        scenario_description: 遇到的问题场景描述
        options_list: 目前可选的几个方案
        """
        print(f"🤖 [决策 Agent] 正在研判场景: '{scenario_description}'...")

        # ── 🛠️ 第一步：静态扫描 Obsidian 决策库 ──
        existing_decisions = ""
        for file in os.listdir(self.decision_dir):
            if file.endswith(".md") and not file.startswith("INDEX"):
                with open(os.path.join(self.decision_dir, file), 'r', encoding='utf-8') as f:
                    existing_decisions += f"\n--- 历史决策: {file} ---\n" + f.read()

        # ── 🧠 第二步：让 Claude 研判历史决策是否能覆盖当前场景 ──
        judgment_prompt = f"""
你是我这套高门槛系统的【决策终审 Agent】。你的职责是判断当前遇到的技术/业务冲突，是否可以被历史决策所覆盖。

以下是【历史已批准的决策列表】:
{existing_decisions}

当前遇到了以下【新冲突场景】:
场景描述: {scenario_description}
可选方案: {options_list}

请研判：
1. 历史决策中是否有能直接指导当前场景的规则？如果有，请给出最终执行方案，并以 `[MATCHED]: <决策文件名和方案>` 开头。
2. 如果这是一个全新的、从未定义过的问题，历史决策无法覆盖，请直接输出 `[UNKNOWN]`，不要瞎猜。
"""
        
        # 调用大模型（可以通过本地 API 或 Claude Code）进行意图判断
        # 这里用伪代码代表调用大模型返回的文本
        response = call_claude_llm(judgment_prompt)

        if "[MATCHED]" in response:
            print("✅ [决策 Agent] 发现匹配的历史合规决策，自动放行！")
            return {"status": "AUTO_PASSED", "decision": response}

        # ── 🚨 第三步：自愈与报警机制（极大化利用 Multica 提醒人类） ──
        if "[UNKNOWN]" in response:
            print("⚠️ [决策 Agent] 这是一个全新的决策空白！正在向 Multica 申请人类仲裁...")
            
            # 1. 在 Multica 上提一个阻塞 Issue，卡片变红，并在手机上轰炸你
            multica_mark_blocked(issue_id, f"遭遇全新决策点，需要人类架构师仲裁: {scenario_description}")
            
            # 2. 把选项和场景通过评论推送到你手机
            human_prompt = (
                f"🙋‍♂️ **请架构师裁决新问题** 🙋‍♂️\n"
                f"Agent 遇到了全新业务分支，不知道该怎么选了：\n"
                f"**场景:** {scenario_description}\n"
                f"**请在回复中选择或指定方案:** {options_list}\n"
            )
            multica_post_comment(issue_id, human_prompt)
            
            # 3. 这里让本地脚本挂起，进入轮询等待（等待你在 Multica 上给出答复）
            # 或者直接熔断，等你下班回来在 Multica/Obsidian 里补上这篇笔记
            human_choice = wait_for_human_multica_reply(issue_id)
            
            # 4. 【核心闭环】：人类给出了方案后，自动在本地生成一篇新的 Obsidian 决策文档！
            new_dec_id = f"DEC-{len(os.listdir(self.decision_dir)):03d}"
            new_file_path = os.path.join(self.decision_dir, f"{new_dec_id}_自动沉淀决策.md")
            with open(new_file_path, 'w', encoding='utf-8') as f_new:
                f_new.write(f"---\ntags: [decision, auto-learned]\nstatus: APPROVED\n---\n")
                f_new.write(f"# {new_dec_id} 针对场景: {scenario_description}\n\n")
                f_new.write(f"- **冲突场景**: {scenario_description}\n")
                f_new.write(f"- **人类裁决方案**: {human_choice}\n")
            
            print(f"💾 新决策已自动固化到知识库: {new_file_path}，下次将不再打扰人类。")
            return {"status": "HUMAN_RESOLVED", "decision": human_choice}

